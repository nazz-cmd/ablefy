            <td><strong>Sentence Builder + 99 Kosakata</strong></td>
        </tr>
        <tr>
            <td><strong>Arsitektur Privasi</strong></td>
            <td>Data dikirim ke cloud</td>
            <td>Bergantung pada database server</td>
            <td><strong>100% Client-First (Zero Backend)</strong></td>
        </tr>
        <tr>
            <td><strong>Navigasi Suara Bebas Tangan</strong></td>
            <td>String matching kaku</td>
            <td>Tidak Tersedia</td>
            <td><strong>NLP Intent Classifier (22 Intent)</strong></td>
        </tr>
